rules_version = '2';
// Roughly — Firestore security rules for Groups.
// Paste these in Firebase Console → Firestore Database → Rules → Publish.
// Model (see FIREBASE-SETUP.md):
//   groups/{gid}                     { name, createdAt, ownerUid, memberUids:[uid…] }
//   groups/{gid}/members/{uid}       { name, joinedAt }
//   groups/{gid}/scores/{day}__{uid} { uid, name, day, avg }
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me()       { return request.auth.uid; }
    function isMember(gid) {
      return signedIn()
        && me() in get(/databases/$(database)/documents/groups/$(gid)).data.memberUids;
    }

    match /groups/{gid} {
      // get: any signed-in user (so an invite link can show the group name before joining).
      allow get: if signedIn();
      // list: only groups you belong to (powers "your groups" via array-contains).
      allow list: if signedIn() && me() in resource.data.memberUids;

      // create: you are the owner and the sole initial member; sane name.
      allow create: if signedIn()
        && request.resource.data.ownerUid == me()
        && request.resource.data.memberUids == [me()]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24;

      // update: name + owner never change here; the ONLY allowed change is adding or
      // removing yourself from memberUids (join / leave). You cannot add or remove anyone else.
      allow update: if signedIn()
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          // join: every existing member kept, I'm newly present, exactly one added (me)
          ( request.resource.data.memberUids.hasAll(resource.data.memberUids)
            && me() in request.resource.data.memberUids
            && !(me() in resource.data.memberUids)
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
            && request.resource.data.memberUids.size() <= 200 )
          ||
          // leave: no one added, I'm newly absent, exactly one removed (me)
          ( resource.data.memberUids.hasAll(request.resource.data.memberUids)
            && me() in resource.data.memberUids
            && !(me() in request.resource.data.memberUids)
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1 )
        );

      allow delete: if false; // groups are not deleted from the client in v1

      match /members/{uid} {
        allow read: if isMember(gid);
        allow create, update: if signedIn() && uid == me()
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 24;
        allow delete: if signedIn() && uid == me();
      }

      match /scores/{sid} {
        allow read: if isMember(gid);
        // You may only write your OWN score, in range 1..100, and only if you're a member.
        // The document id MUST be "<day>__<uid>" so a member can write at most ONE
        // score per day — this blocks stacking many docs to inflate a weekly total.
        allow create, update: if signedIn()
          && request.resource.data.uid == me()
          && request.resource.data.day is int
          && request.resource.data.day >= 20000 && request.resource.data.day <= 30000
          // Only today's drop counts (±1 day for time zones): past drops never reach the board.
          && request.resource.data.day >= math.floor(request.time.toMillis() / 86400000) - 1
          && request.resource.data.day <= math.floor(request.time.toMillis() / 86400000) + 1
          && sid == string(request.resource.data.day) + '__' + me()
          && request.resource.data.avg is number
          && request.resource.data.avg >= 1
          && request.resource.data.avg <= 100
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 24
          && isMember(gid);
        allow delete: if false;
      }
    }
  }
}
